rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Never allow passwords or password hashes/salts to be stored
    // in Firestore from the client.
    function hasForbiddenKeys() {
      return request.resource.data.keys().hasAny([
        'password',
        'passwordHash',
        'passwordSalt'
      ]);
    }

    function driverUidMatches(driverId) {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == driverId;
    }

    // New drivers must start unapproved.
    function isUnapprovedOnCreate() {
      return request.resource.data.get('isApproved', false) == false;
    }

    // Driver cannot change their own approval status.
    function approvalUnchanged() {
      return request.resource.data.get('isApproved', false)
          == resource.data.get('isApproved', false);
    }

    function isApprovedDriver() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid))
             .data.get('isApproved', false) == true;
    }

    function isAssignedDriver(rideData) {
      return rideData.get('driverId', null) == request.auth.uid;
    }

    function isPreArrivingAssigned(status) {
      return status == 'driver_selected' || status == 'accepted';
    }

    function isActiveAssignedStatus(status) {
      return status == 'driver_selected'
        || status == 'accepted'
        || status == 'driver_arriving'
        || status == 'driver_arrived'
        || status == 'passenger_arriving'
        || status == 'ride_started'
        || status == 'riderArrived'
        || status == 'inProgress'
        || status == 'in_progress';
    }

    function rideDoc(id) {
      return get(/databases/$(database)/documents/rides/$(id));
    }

    function rideIsOpenForOffers(id) {
      return rideDoc(id).data.status in ['pending', 'expired'];
    }

    function reservationDoc(id) {
      return get(/databases/$(database)/documents/reservations/$(id));
    }

    // Rider apps may store the owner as userId, customerId, or uid.
    function reservationCustomerId(data) {
      return data.get('userId', data.get('customerId', data.get('uid', '')));
    }

    function isReservationOwner(data) {
      return isSignedIn() && reservationCustomerId(data) == request.auth.uid;
    }

    function hasNoAssignedDriver(data) {
      return !('driverId' in data)
        || data.driverId == null
        || data.driverId == '';
    }

    function reservationStatus(data) {
      return data.get('status', '') is string && data.get('status', '') != ''
        ? data.get('status', '').lower()
        : 'pending';
    }

    function isPendingReservation(data) {
      return reservationStatus(data) == 'pending';
    }

    // Driver app writes `confirm`. Also allow legacy aliases.
    function isUpcomingReservation(data) {
      return reservationStatus(data) in [
        'confirm',
        'confirmed',
        'upcoming',
        'accepted'
      ];
    }

    function isLiveReservationStatus(status) {
      return status == 'driver_arriving'
        || status == 'driver_arrived'
        || status == 'ride_started';
    }

    function isConfirmStatusValue(status) {
      return status in [
        'confirm',
        'confirmed',
        'upcoming',
        'accepted'
      ];
    }

    function isActiveReservationLifecycle(status) {
      return isConfirmStatusValue(status)
        || isLiveReservationStatus(status);
    }

    function reservationLifecycleKeys() {
      return [
        'status',
        'updatedAt',
        'driverArrivedAt',
        'startedAt',
        'completedAt',
        'cancelledAt'
      ];
    }

    function reservationAssignedDriverUnchanged() {
      return request.resource.data.get('driverId', '')
          == resource.data.get('driverId', '')
        && request.resource.data.get('driverId', '') == request.auth.uid;
    }

    function reservationCustomerUnchanged() {
      return reservationCustomerId(request.resource.data)
          == reservationCustomerId(resource.data);
    }

    function reservationHasNoRide(data) {
      return !('rideId' in data)
        || data.rideId == null
        || data.rideId == '';
    }

    // Driver accept writes assignment + vehicle snapshot fields.
    // Do not allow fare, route, customer, or schedule keys here.
    function reservationDriverClaimKeys() {
      return [
        'status',
        'driverId',
        'driverName',
        'driverPhone',
        'vehicleName',
        'vehicleNumber',
        'rideId',
        'updatedAt',
        'acceptedAt'
      ];
    }

    function reservationDriverSnapshotFieldsValid() {
      return request.resource.data.get('driverName', '') is string
        && request.resource.data.get('driverPhone', '') is string
        && request.resource.data.get('vehicleName', '') is string
        && request.resource.data.get('vehicleNumber', '') is string;
    }

    function reservationIsClaimable(id) {
      return exists(/databases/$(database)/documents/reservations/$(id))
        && isPendingReservation(reservationDoc(id).data)
        && hasNoAssignedDriver(reservationDoc(id).data);
    }

    // Driver may create the linked ride on Accept (legacy) or later
    // on Start Ride after the reservation is already confirmed.
    function reservationAllowsDriverRideCreate(id) {
      return exists(/databases/$(database)/documents/reservations/$(id))
        && reservationHasNoRide(reservationDoc(id).data)
        && reservationCustomerId(reservationDoc(id).data) != ''
        && (
          reservationIsClaimable(id)
          || (
            isUpcomingReservation(reservationDoc(id).data)
            && (
              hasNoAssignedDriver(reservationDoc(id).data)
              || reservationDoc(id).data.get('driverId', '') == request.auth.uid
            )
          )
        );
    }

    // Rider apps may store the owner as customerId, userId, uid, or riderId.
    function rideCustomerId(data) {
      return data.get('customerId', '') != ''
        ? data.get('customerId', '')
        : data.get('userId', data.get('uid', data.get('riderId', '')));
    }

    function isRideOwner(data) {
      return isSignedIn() && rideCustomerId(data) == request.auth.uid;
    }

    function isAssignedLiveStatus(status) {
      return status == 'driver_selected'
        || status == 'accepted'
        || status == 'selected'
        || status == 'driver_accepted';
    }

    function isSelectableRideStatus(status) {
      return status == 'pending' || status == 'expired';
    }

    function isValidSelectedDriverId(driverId) {
      return driverId is string
        && driverId != ''
        && driverId != request.auth.uid
        && exists(/databases/$(database)/documents/drivers/$(driverId));
    }

    function riderConfirmingSelectedDriver() {
      return isRideOwner(request.resource.data)
        && isAssignedLiveStatus(request.resource.data.status)
        && isValidSelectedDriverId(request.resource.data.driverId);
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && !hasForbiddenKeys();

      allow update: if isOwner(userId)
        && !hasForbiddenKeys();

      allow delete: if false;
    }


    // ============================================================
    // DRIVERS
    // ============================================================

    match /drivers/{driverId} {

      // Rider app needs to read driver documents while searching
      // for an available driver during live booking.
      allow read: if isSignedIn();

      allow create: if isOwner(driverId)
        && !hasForbiddenKeys()
        && driverUidMatches(driverId)
        && isUnapprovedOnCreate();

      // Rider may also set currentRideId when they select this driver
      // on their own live booking.
      allow update: if (
        (
          isOwner(driverId)
          && !hasForbiddenKeys()
          && driverUidMatches(driverId)
          && approvalUnchanged()
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['currentRideId', 'updatedAt'])
          && request.resource.data.currentRideId is string
          && request.resource.data.currentRideId != ''
          && (
            !('currentRideId' in resource.data)
            || resource.data.currentRideId == null
            || resource.data.currentRideId == ''
            || resource.data.currentRideId == request.resource.data.currentRideId
          )
          && exists(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId))
          && isRideOwner(
               getAfter(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId)).data
             )
          && (
            (
              getAfter(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId))
                .data.get('driverId', '') == driverId
              && isAssignedLiveStatus(
                   getAfter(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId)).data.status
                 )
            )
            || (
              isSelectableRideStatus(
                getAfter(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId)).data.status
              )
              && exists(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId)/driverOffers/$(driverId))
              && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.currentRideId)/driverOffers/$(driverId))
                   .data.status in ['driver_accepted', 'rider_selected']
            )
          )
        )
      );

      // Driver may permanently delete only their own profile document.
      allow delete: if isOwner(driverId);
    }


    // ============================================================
    // DRIVER INFORMATION
    // ============================================================

    match /driver_information/{driverId} {

      allow read: if isSignedIn();

      allow create, update: if isOwner(driverId)
        && !hasForbiddenKeys()
        && driverUidMatches(driverId);

      // Driver may permanently delete only their own vehicle/CNIC document.
      allow delete: if isOwner(driverId);
    }


    // ============================================================
    // RIDES
    // Shared between User App + Driver App
    // ============================================================

    match /rides/{rideId} {

      allow read: if isSignedIn();

      // ------------------------------------------------------------
      // USER CREATES PENDING RIDE
      // ------------------------------------------------------------

      allow create: if isSignedIn() && (

        // Rider creates a live pending search.
        (
          request.resource.data.status == 'pending'
          && isRideOwner(request.resource.data)
          && (
            !('driverId' in request.resource.data)
            || request.resource.data.driverId == null
            || request.resource.data.driverId == ''
            || isValidSelectedDriverId(request.resource.data.driverId)
          )
        )

        // Rider confirms live booking by selecting a driver
        // (some user-app builds create/set the assigned ride here).
        || riderConfirmingSelectedDriver()

        // Approved driver accepts a pending reservation and creates the
        // linked assigned ride (status driver_arriving).
        || (
          isApprovedDriver()
          && request.resource.data.status == 'driver_arriving'
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.customerId is string
          && request.resource.data.customerId != ''
          && request.resource.data.customerId != request.auth.uid
          && request.resource.data.reservationId is string
          && request.resource.data.reservationId != ''
          && reservationAllowsDriverRideCreate(request.resource.data.reservationId)
          && reservationCustomerId(
               reservationDoc(request.resource.data.reservationId).data
             ) == request.resource.data.customerId
        )
      );

      // ------------------------------------------------------------
      // RIDE UPDATES
      // ------------------------------------------------------------

      allow update: if isSignedIn() && (

        // Rider cancels pending ride
        (
          resource.data.status == 'pending'
          && resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'cancelled'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('driverId', null)
              == resource.data.get('driverId', null)
        )

        // Rider accepts / selects an offered driver on their own ride.
        || (
          isRideOwner(resource.data)
          && isRideOwner(request.resource.data)
          && rideCustomerId(request.resource.data) == rideCustomerId(resource.data)
          && isValidSelectedDriverId(request.resource.data.driverId)
          && (
            isSelectableRideStatus(resource.data.status)
            || (
              isAssignedLiveStatus(resource.data.status)
              && resource.data.get('driverId', '')
                  == request.resource.data.driverId
            )
          )
          && (
            riderConfirmingSelectedDriver()
            || (
              isSelectableRideStatus(resource.data.status)
              && request.resource.data.status == resource.data.status
            )
          )
        )

        // Rider extends pending search expiry (decline → re-offer)
        || (
          resource.data.status == 'pending'
          && resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'expiresAt',
                'updatedAt'
              ])
        )

        // Rider completes their own assigned ride
        || (
          resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.status == 'completed'
          && isActiveAssignedStatus(resource.data.status)
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'completedAt',
                'updatedAt'
              ])
        )

        // Rider: I'm here (legacy)
        || (
          isPreArrivingAssigned(resource.data.status)
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('driverId', null)
              == resource.data.get('driverId', null)
          && request.resource.data.riderArrived == true
          && (
            isPreArrivingAssigned(request.resource.data.status)
            || request.resource.data.status == 'riderArrived'
          )
        )

        // Rider: I'm Coming — driver_arrived → passenger_arriving
        || (
          resource.data.status == 'driver_arrived'
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('driverId', null)
              == resource.data.get('driverId', null)
          && request.resource.data.status == 'passenger_arriving'
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'updatedAt'
              ])
        )

        // Approved driver claims pending / expired ride
        // (pending → driver_arriving; legacy accepted / driver_selected kept for old clients)
        || (
          (
            resource.data.status == 'pending'
            || resource.data.status == 'expired'
          )
          && (
            request.resource.data.status == 'driver_arriving'
            || request.resource.data.status == 'accepted'
            || request.resource.data.status == 'driver_selected'
          )
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
          && (
            !('driverId' in resource.data)
            || resource.data.driverId == null
            || resource.data.driverId == ''
            || resource.data.driverId == request.auth.uid
          )
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'driverId',
                'driverName',
                'driverFirstName',
                'driverLastName',
                'driverPhone',
                'driverVehicle',
                'driverVehicleNumber',
                'driverVehicleType',
                'driverVehicleMake',
                'driverVehicleModel',
                'driverVehicleColor',
                'driverVehicleRegistration',
                'driverRating',
                'driverDistanceMiles',
                'driverEta',
                'acceptedAt',
                'arrivingAt',
                'updatedAt'
              ])
        )

        // Approved driver may NOT cancel unassigned pending/expired rides
        // (Decline is local-only on the client). Assigned-driver cancel below.
        || (
          isActiveAssignedStatus(resource.data.status)
          && isAssignedDriver(resource.data)
          && request.resource.data.status == 'cancelled'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
        )

        // accepted / driver_selected -> driver_arriving
        || (
          isPreArrivingAssigned(resource.data.status)
          && isAssignedDriver(resource.data)
          && request.resource.data.status == 'driver_arriving'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
        )

        // driver_arriving -> driver_arrived
        || (
          resource.data.status == 'driver_arriving'
          && isAssignedDriver(resource.data)
          && request.resource.data.status == 'driver_arrived'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
        )

        // passenger_arriving -> ride_started
        || (
          resource.data.status == 'passenger_arriving'
          && isAssignedDriver(resource.data)
          && request.resource.data.status == 'ride_started'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
        )

        // ride_started / inProgress -> completed
        || (
          (
            resource.data.status == 'ride_started'
            || resource.data.status == 'inProgress'
            || resource.data.status == 'in_progress'
          )
          && isAssignedDriver(resource.data)
          && request.resource.data.status == 'completed'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && isApprovedDriver()
        )

        // Driver live GPS updates
        || (
          isAssignedDriver(resource.data)
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == resource.data.status
          && isActiveAssignedStatus(resource.data.status)
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'driverLocation',
                'driverLocationUpdatedAt',
                'updatedAt'
              ])
        )

        // Assigned driver advances multi-stop progress
        || (
          isAssignedDriver(resource.data)
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == resource.data.status
          && isActiveAssignedStatus(resource.data.status)
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'currentStopIndex',
                'updatedAt'
              ])
          && request.resource.data.currentStopIndex is int
          && request.resource.data.currentStopIndex >= 0
        )
      );

      allow delete: if false;

      // ------------------------------------------------------------
      // DRIVER OFFERS (legacy rider-selection path)
      // New Accept claims the ride doc directly as driver_arriving.
      // Path: rides/{rideId}/driverOffers/{driverId}
      // ------------------------------------------------------------

      match /driverOffers/{driverId} {

        allow read: if isSignedIn();

        allow create: if isOwner(driverId)
          && isApprovedDriver()
          && rideIsOpenForOffers(rideId)
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'driver_accepted';

        allow update: if (

          // Driver submits / refreshes / withdraws their own offer.
          (
            isOwner(driverId)
            && isApprovedDriver()
            && request.resource.data.driverId == request.auth.uid
            && resource.data.driverId == request.auth.uid
            && rideIsOpenForOffers(rideId)
            && (
              (
                request.resource.data.status == 'driver_accepted'
                && resource.data.status in ['driver_accepted', 'cancelled']
              )
              || (
                resource.data.status == 'driver_accepted'
                && request.resource.data.status == 'cancelled'
              )
            )
          )

          // Rider selects or declines offers on their own ride.
          || (
            isSignedIn()
            && exists(/databases/$(database)/documents/rides/$(rideId))
            && isRideOwner(rideDoc(rideId).data)
            && rideDoc(rideId).data.status in [
              'pending',
              'expired',
              'driver_selected',
              'accepted',
              'selected',
              'driver_accepted'
            ]
            && resource.data.status in ['driver_accepted', 'rider_selected']
            && request.resource.data.status in ['rider_selected', 'rider_declined']
            && request.resource.data.get('driverId', resource.data.get('driverId', driverId))
                == resource.data.get('driverId', driverId)
          )
        );

        allow delete: if false;
      }

      // ------------------------------------------------------------
      // IN-RIDE CHAT MESSAGES
      // rides/{rideId}/messages/{messageId}
      // ------------------------------------------------------------

      match /messages/{messageId} {

        allow read: if isSignedIn()
          && (
            isRideOwner(rideDoc(rideId).data)
            || isAssignedDriver(rideDoc(rideId).data)
          );

        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/rides/$(rideId))
          && isActiveAssignedStatus(rideDoc(rideId).data.status)
          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderType',
            'message',
            'createdAt',
            'read',
            'type'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.type == 'text'
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && (
            (
              isRideOwner(rideDoc(rideId).data)
              && request.resource.data.senderType == 'rider'
            )
            || (
              isAssignedDriver(rideDoc(rideId).data)
              && isApprovedDriver()
              && request.resource.data.senderType == 'driver'
            )
          );

        // Recipient may mark peer messages as read only.
        allow update: if isSignedIn()
          && exists(/databases/$(database)/documents/rides/$(rideId))
          && (
            isRideOwner(rideDoc(rideId).data)
            || isAssignedDriver(rideDoc(rideId).data)
          )
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['read'])
          && resource.data.read == false
          && request.resource.data.read == true
          && resource.data.senderId != request.auth.uid;

        allow delete: if false;
      }
    }


    // ============================================================
    // RESERVATIONS
    // Scheduled bookings
    // ============================================================

    match /reservations/{reservationId} {

      // Owner, assigned driver, or any approved driver (dispatch list).
      allow read: if isSignedIn()
        && (
          isReservationOwner(resource.data)
          || resource.data.get('driverId', '') == request.auth.uid
          || isApprovedDriver()
        );

      // User creates own reservation.
      allow create: if isReservationOwner(request.resource.data);

      allow update: if isSignedIn() && (

        // Owner can update their own reservation without changing owner.
        (
          isReservationOwner(resource.data)
          && reservationCustomerId(request.resource.data)
              == reservationCustomerId(resource.data)
        )

        // Approved driver accepts a pending reservation
        // (pending → confirm + driverId + driver/vehicle snapshot).
        // rideId is optional because the driver app confirms first
        // and creates the ride later.
        || (
          isApprovedDriver()
          && isPendingReservation(resource.data)
          && hasNoAssignedDriver(resource.data)
          && isUpcomingReservation(request.resource.data)
          && request.resource.data.driverId == request.auth.uid
          && reservationCustomerId(request.resource.data)
              == reservationCustomerId(resource.data)
          && reservationDriverSnapshotFieldsValid()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(reservationDriverClaimKeys())
        )

        // Approved driver starts a confirmed reservation ride
        // (confirm → driver_arriving + rideId).
        || (
          isApprovedDriver()
          && isUpcomingReservation(resource.data)
          && reservationHasNoRide(resource.data)
          && (
            hasNoAssignedDriver(resource.data)
            || resource.data.get('driverId', '') == request.auth.uid
          )
          && request.resource.data.driverId == request.auth.uid
          && reservationStatus(request.resource.data) == 'driver_arriving'
          && reservationCustomerId(request.resource.data)
              == reservationCustomerId(resource.data)
          && request.resource.data.rideId is string
          && request.resource.data.rideId != ''
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'driverId', 'rideId', 'updatedAt'])
        )

        // Assigned driver cancels an active reservation lifecycle
        // (never from completed). Used when cancelAssignedRide mirrors
        // the linked reservation.
        || (
          isApprovedDriver()
          && isActiveReservationLifecycle(reservationStatus(resource.data))
          && reservationStatus(resource.data) != 'completed'
          && reservationStatus(request.resource.data) == 'cancelled'
          && reservationAssignedDriverUnchanged()
          && reservationCustomerUnchanged()
          && request.resource.data.get('rideId', resource.data.get('rideId', ''))
               == resource.data.get('rideId', '')
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(reservationLifecycleKeys())
        )

        // Approved driver declines a pending reservation — removed.
        // Decline is local-only on the client (hide from this driver's feed).
      );

      // User deletes own reservation.
      allow delete: if isReservationOwner(resource.data);
    }


    // ============================================================
    // LEGACY RIDE REQUESTS (defense-in-depth; live claim uses /rides)
    // ============================================================

    match /rideRequests/{rideId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.get('status', 'pending') in ['pending', 'expired']
        && hasNoAssignedDriver(request.resource.data);

      // First-accept-wins claim: pending/expired + empty driverId → assigned.
      allow update: if isSignedIn() && (
        (
          resource.data.status in ['pending', 'expired']
          && hasNoAssignedDriver(resource.data)
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status in [
            'accepted',
            'driver_arriving',
            'driver_selected'
          ]
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'driverId',
                'acceptedAt',
                'updatedAt',
                'fare',
                'offeredFare'
              ])
        )
        // Owner / rider may cancel or expire their own request.
        || (
          isRideOwner(resource.data)
          && request.resource.data.status in ['cancelled', 'expired', 'completed']
          && request.resource.data.get('driverId', resource.data.get('driverId', null))
              == resource.data.get('driverId', null)
        )
        // Assigned driver may update lifecycle on their claim.
        || (
          isAssignedDriver(resource.data)
          && request.resource.data.driverId == resource.data.driverId
          && isActiveAssignedStatus(request.resource.data.status)
        )
      );

      allow delete: if false;
    }

  }
}
